PORT=4000
MONGODB_URI=your-mongodb-connection-string
SESSION_SECRET=replace-with-a-long-random-string
NODE_ENV=development

FRONTEND_URL=http://localhost:3000

LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.6-flash

REQUEST_TIMEOUT_MS=10000
MAX_PAGES_PER_CRAWL=8
USER_AGENT=interview-kit-bot/1.0

RETRIEVAL_MIN_DELAY_MS=500
MAX_CONTENT_BYTES=200000

# production: false, development: true (only if you're testing against a
# local mock server, e.g. http://localhost:8099)
ALLOW_PRIVATE_URLS=false