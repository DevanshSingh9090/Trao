# Server
PORT=4000
MONGODB_URI=your-mongodb-connection-string
SESSION_SECRET=replace-with-a-long-random-string
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# LLM provider (pick one, document choice in README)
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-3.6-flash

# Retrieval
REQUEST_TIMEOUT_MS=10000
MAX_PAGES_PER_CRAWL=8
USER_AGENT=interview-kit-bot/1.0
RETRIEVAL_MIN_DELAY_MS=500
MAX_CONTENT_BYTES=200000

# The batch CLI (batch/evaluate.ts) reads its credentials from this file too —
# no separate setup is needed to run `npm run evaluate`.

# Local development only. Keep false in production.
ALLOW_PRIVATE_URLS=false

# =========================
# Frontend
# =========================
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000